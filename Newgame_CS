<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Latte & Liabilities: The Layover Dilemma</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #38bdf8;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
            background-image: radial-gradient(circle at top right, #1e293b, #0f172a);
        }

        #game-container {
            width: 100%;
            max-width: 800px;
            background: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            padding: 30px;
            position: relative;
            overflow: hidden;
            min-height: 600px;
            display: flex;
            flex-direction: column;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #334155;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 1.5rem;
            color: var(--accent);
        }

        .time-badge {
            background: #334155;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            font-family: monospace;
            font-size: 1.2rem;
        }

        .dashboard {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .metric {
            background: #0f172a;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #334155;
        }

        .metric-title {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .progress-bar-bg {
            background: #334155;
            height: 12px;
            border-radius: 6px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #security-fill {
            background: var(--success);
            width: 100%;
        }

        #work-fill {
            background: var(--accent);
            width: 0%;
        }

        .story-area {
            flex-grow: 1;
            margin-bottom: 20px;
        }

        .story-title {
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .story-desc {
            font-size: 1.1rem;
            line-height: 1.6;
            color: #cbd5e1;
        }

        .options-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option-btn {
            background: #0f172a;
            border: 2px solid #334155;
            color: var(--text-main);
            padding: 15px 20px;
            border-radius: 10px;
            text-align: left;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .option-btn:hover {
            border-color: var(--accent);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
        }

        .option-stats {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-family: monospace;
        }

        /* Modal Overlay for Feedback */
        #feedback-modal {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.95);
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            text-align: center;
            z-index: 10;
        }

        #feedback-modal h2 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        #feedback-desc {
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 25px;
            color: #cbd5e1;
        }

        .compliance-tag {
            background: #334155;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            color: var(--accent);
            margin-bottom: 30px;
            display: inline-block;
        }

        .next-btn {
            background: var(--accent);
            color: #0f172a;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.2s;
        }

        .next-btn:hover {
            background: #7dd3fc;
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: flex;
            flex-direction: column;
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .screen-center {
            text-align: center;
            justify-content: center;
            align-items: center;
            height: 100%;
        }

        .start-btn {
            margin-top: 30px;
            background: var(--accent);
            color: #0f172a;
            padding: 15px 40px;
            font-size: 1.2rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div id="game-container">

        <div id="screen-start" class="screen active screen-center">
            <h1 style="font-size: 3rem; margin-bottom: 10px; color: var(--accent);">Latte & Liabilities</h1>
            <h2 style="color: var(--text-muted); margin-bottom: 30px;">The Layover Dilemma</h2>
            <p style="max-width: 500px; line-height: 1.6; margin-bottom: 20px;">
                You have a two-hour layover at JFK International. You need to finish the Q3 Sensitive Financial Report
                before you board.
            </p>
            <p style="max-width: 500px; line-height: 1.6; color: var(--warning);">
                Your goal: Get the report done (100% Progress) without compromising corporate data (Security reaching
                0%).
            </p>
            <button class="start-btn" onclick="startGame()">Start Working</button>
        </div>

        <div id="screen-game" class="screen">
            <div class="header">
                <h1>Q3 Financial Report</h1>
                <div class="time-badge" id="time-display">120 Mins Left</div>
            </div>

            <div class="dashboard">
                <div class="metric">
                    <div class="metric-title">Data Security Level</div>
                    <div class="progress-bar-bg">
                        <div id="security-fill" class="progress-bar-fill"></div>
                    </div>
                </div>
                <div class="metric">
                    <div class="metric-title">Report Completion</div>
                    <div class="progress-bar-bg">
                        <div id="work-fill" class="progress-bar-fill"></div>
                    </div>
                </div>
            </div>

            <div class="story-area">
                <h2 id="story-title" class="story-title">Situation Title</h2>
                <p id="story-desc" class="story-desc">Situation description goes here...</p>
            </div>

            <div class="options-container" id="options-container">
            </div>

            <div id="feedback-modal">
                <h2 id="feedback-title">Result</h2>
                <div id="compliance-tag" class="compliance-tag">ISO 27001 Alignment</div>
                <p id="feedback-desc">Feedback description</p>
                <button class="next-btn" onclick="nextScenario()">Continue</button>
            </div>
        </div>

        <div id="screen-end" class="screen screen-center">
            <h1 id="end-title" style="font-size: 3rem; margin-bottom: 20px;">Game Over</h1>
            <p id="end-desc" style="max-width: 600px; line-height: 1.6; margin-bottom: 30px; font-size: 1.2rem;">Result
                details here.</p>
            <button class="start-btn" onclick="location.reload()">Play Again</button>
        </div>

    </div>

    <script>
        // Game State
        let state = {
            security: 100,
            work: 0,
            time: 120,
            currentStep: 0
        };

        const scenarios = [
            {
                title: "The Connection Conundrum",
                desc: "You sit down with your over-priced macchiato. You need to pull down the Q3 financial data from the corporate drive. Your laptop detects several networks. Time is ticking.",
                options: [
                    {
                        text: "Connect to 'Free_JFK_WiFi_Fast'",
                        work: 25, sec: -50, time: -15,
                        title: "Rookie Mistake!",
                        feedback: "You got the data quickly, but open Wi-Fi networks transmit data in plain text. A threat actor just intercepted your session token using a simple packet sniffer.",
                        compliance: "CIS Control 4: Secure Configuration (Avoid untrusted networks)"
                    },
                    {
                        text: "Use Airport Wi-Fi + Corporate VPN",
                        work: 20, sec: -10, time: -20,
                        title: "Better, but not bulletproof.",
                        feedback: "The VPN encrypts your traffic, protecting the contents. However, 'Evil Twin' rogue access points can still attempt man-in-the-middle attacks to steal credentials.",
                        compliance: "ISO 27001 A.6.2.2: Teleworking (Use VPNs on public networks)"
                    },
                    {
                        text: "Enable Personal Mobile Hotspot",
                        work: 20, sec: 0, time: -20,
                        title: "Excellent Move!",
                        feedback: "Using a dedicated mobile hotspot ensures your traffic is isolated from the public network, significantly reducing the attack surface.",
                        compliance: "ISO 27001 A.6.2.2: Teleworking (Secure routing of communications)"
                    }
                ]
            },
            {
                title: "The Nosy Neighbor",
                desc: "You're deep into pivot tables containing payroll data. A guy sits uncomfortably close to you and keeps glancing at your screen while 'pretending' to read a magazine.",
                options: [
                    {
                        text: "Ignore him and type faster.",
                        work: 30, sec: -40, time: -30,
                        title: "Data Leakage!",
                        feedback: "Visual hacking (shoulder surfing) is highly effective. He just took a mental note (or a discreet smartphone picture) of the executive salary structures.",
                        compliance: "ISO 27001 A.11.2.9: Clear Desk and Clear Screen Policy"
                    },
                    {
                        text: "Dim screen and angle laptop away.",
                        work: 20, sec: -10, time: -35,
                        title: "Good situational awareness.",
                        feedback: "You mitigated the immediate risk, but it makes working harder and strains your eyes. A physical privacy screen would be much better.",
                        compliance: "CIS Control 4 (Physical security considerations)"
                    },
                    {
                        text: "Attach magnetic privacy screen.",
                        work: 30, sec: 0, time: -30,
                        title: "Pro-Tier Security!",
                        feedback: "Privacy screens narrow the viewing angle. The snooper sees nothing but a black screen, and you can work at full speed.",
                        compliance: "ISO 27001 A.11.2.9: Clear Screen Policy"
                    }
                ]
            },
            {
                title: "The Caffeine Call",
                desc: "You've been working for an hour and desperately need the restroom. Your laptop is open, and you have exactly 30 minutes left before boarding.",
                options: [
                    {
                        text: "Leave it open, you'll be back in 2 mins.",
                        work: 15, sec: -100, time: -5,
                        title: "Catastrophic Breach!",
                        feedback: "Never leave an unlocked, logged-in device unattended in public. Someone plugged in a malicious USB 'Rubber Ducky' and installed a backdoor in 15 seconds.",
                        compliance: "CIS Control 4: Session locking and physical security"
                    },
                    {
                        text: "Lock the screen (Win+L / Cmd+Ctrl+Q) and run.",
                        work: 10, sec: -30, time: -10,
                        title: "Risky Business.",
                        feedback: "Locking the screen protects the digital session, but physical theft is still a massive risk. A stolen encrypted laptop is still a costly incident.",
                        compliance: "ISO 27001 A.11.2.8: Unattended user equipment"
                    },
                    {
                        text: "Pack it up, take it with you.",
                        work: 0, sec: 0, time: -15,
                        title: "Inconvenient but Secure.",
                        feedback: "It broke your flow and cost you time, but maintaining physical custody of corporate assets in public spaces is mandatory.",
                        compliance: "ISO 27001 A.11.2.8: Unattended user equipment"
                    }
                ]
            },
            {
                title: "The Urgent Request",
                desc: "You sit back down. An email pops up: 'URGENT: Q3 Report Submission Portal Changed. Login here immediately to submit.' The sender name says 'IT Admin'.",
                options: [
                    {
                        text: "Click the link and submit quickly!",
                        work: 40, sec: -100, time: -10,
                        title: "Phished!",
                        feedback: "The classic sense of urgency combined with a change in procedure. You just handed over your corporate credentials to a phishing site and uploaded sensitive data to a threat actor.",
                        compliance: "CIS Control 14: Security Awareness and Skills Training"
                    },
                    {
                        text: "Hover the link, notice it looks weird, report it.",
                        work: 35, sec: 0, time: -20,
                        title: "Crisis Averted!",
                        feedback: "You spotted the phishing attempt! You manually navigated to the standard reporting portal, logged in securely, and uploaded the document.",
                        compliance: "CIS Control 14 & ISO 27001 (Information security event reporting)"
                    }
                ]
            }
        ];

        function updateUI() {
            // Clamp values
            state.security = Math.max(0, Math.min(100, state.security));
            state.work = Math.max(0, Math.min(100, state.work));

            // Update bars
            const secFill = document.getElementById('security-fill');
            secFill.style.width = state.security + '%';
            secFill.style.background = state.security > 50 ? 'var(--success)' : (state.security > 20 ? 'var(--warning)' : 'var(--danger)');

            document.getElementById('work-fill').style.width = state.work + '%';

            // Update time
            document.getElementById('time-display').innerText = state.time + " Mins Left";
        }

        function switchScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }

        function startGame() {
            switchScreen('screen-game');
            loadScenario();
        }

        function loadScenario() {
            if (state.security <= 0 || state.time <= 0 || state.currentStep >= scenarios.length || state.work >= 100) {
                endGame();
                return;
            }

            const scenario = scenarios[state.currentStep];
            document.getElementById('story-title').innerText = scenario.title;
            document.getElementById('story-desc').innerText = scenario.desc;

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            scenario.options.forEach((opt, index) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';

                // Format stats impact
                let secColor = opt.sec < 0 ? 'var(--danger)' : 'var(--text-muted)';
                let workColor = opt.work > 0 ? 'var(--accent)' : 'var(--text-muted)';

                btn.innerHTML = `
                <span>${opt.text}</span>
                <span class="option-stats">
                    <span style="color:${workColor}">Work +${opt.work}%</span> | 
                    <span style="color:${secColor}">Sec ${opt.sec}%</span>
                </span>
            `;
                btn.onclick = () => makeChoice(index);
                optionsContainer.appendChild(btn);
            });

            updateUI();
        }

        function makeChoice(optionIndex) {
            const scenario = scenarios[state.currentStep];
            const choice = scenario.options[optionIndex];

            // Apply state changes
            state.work += choice.work;
            state.security += choice.sec;
            state.time += choice.time;
            updateUI();

            // Show feedback modal
            document.getElementById('feedback-title').innerText = choice.title;
            document.getElementById('feedback-title').style.color = choice.sec < 0 ? 'var(--danger)' : 'var(--success)';
            document.getElementById('feedback-desc').innerText = choice.feedback;
            document.getElementById('compliance-tag').innerText = choice.compliance;

            document.getElementById('feedback-modal').style.display = 'flex';
        }

        function nextScenario() {
            document.getElementById('feedback-modal').style.display = 'none';
            state.currentStep++;
            loadScenario();
        }

        function endGame() {
            switchScreen('screen-end');
            const titleEl = document.getElementById('end-title');
            const descEl = document.getElementById('end-desc');

            if (state.security <= 0) {
                titleEl.innerText = "Corporate Breach!";
                titleEl.style.color = "var(--danger)";
                descEl.innerText = `You failed to protect sensitive data. While you completed ${state.work}% of the report, the resulting data breach cost the company millions in regulatory fines. Security must enable the business, but ignoring it destroys the business.`;
            } else if (state.time <= 0 && state.work < 100) {
                titleEl.innerText = "Missed Deadline!";
                titleEl.style.color = "var(--warning)";
                descEl.innerText = `You kept the data perfectly secure (Security: ${state.security}%), but you ran out of time, only completing ${state.work}% of the report. The key is balancing productivity with security!`;
            } else if (state.work >= 100) {
                titleEl.innerText = "Mission Accomplished!";
                titleEl.style.color = "var(--success)";
                descEl.innerText = `Excellent work! You submitted the report on time and maintained a solid security posture (${state.security}% Security remaining). You are ready for safe teleworking!`;
            } else {
                titleEl.innerText = "Boarding Call!";
                titleEl.style.color = "var(--accent)";
                descEl.innerText = `Time to board your flight! You finished ${state.work}% of the report with a security score of ${state.security}%. Not bad, but you can always improve!`;
            }
        }
    </script>

</body>

</html>