< !DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Corporate Chronicles: Security Simulations</title><style> :root {
    --bg-top: #4f46e5;
    --bg-bottom: #c084fc;
    --glass-bg: rgba(255, 255, 255, 0.7);
    --glass-border: rgba(255, 255, 255, 0.5);
    --text-dark: #1e293b;
    --text-muted: #64748b;
    --accent-main: #4f46e5;
    --success: #10b981;
    --danger: #ef4444;
    --warning: #f59e0b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background: linear-gradient(135deg, var(--bg-top), var(--bg-bottom));
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
}

#game-container {
    width: 100%;
    max-width: 1000px;
    height: 700px;
    background: var(--glass-bg);
    border: 2px solid var(--glass-border);
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
}

/* Screens */
.screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    flex-direction: column;
    z-index: 10;
}

.screen.active {
    display: flex;
    animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Shared UI Elements */
.header-bar {
    background: white;
    padding: 15px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #e2e8f0;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    z-index: 20;
}

.level-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--accent-main);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.score-badge {
    background: #f1f5f9;
    padding: 8px 16px;
    border-radius: 12px;
    font-weight: bold;
    color: var(--text-dark);
    border: 1px solid #cbd5e1;
}

.btn-main {
    background: linear-gradient(135deg, var(--accent-main), #8b5cf6);
    color: white;
    border: none;
    padding: 15px 40px;
    font-size: 1.2rem;
    font-weight: bold;
    border-radius: 30px;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(79, 70, 229, 0.3);
    transition: all 0.2s;
}

.btn-main:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 25px rgba(79, 70, 229, 0.4);
}

/* Level 1: Point and Click (Clean Desk) */
.office-env {
    flex-grow: 1;
    position: relative;
    background: linear-gradient(to bottom, #f8fafc 40%, #cbd5e1 40%, #e2e8f0 100%);
}

.office-wall {
    position: absolute;
    top: 0;
    width: 100%;
    height: 40%;
    border-bottom: 4px solid #94a3b8;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 20px;
    font-size: 1.5rem;
    color: #cbd5e1;
    font-weight: bold;
    letter-spacing: 5px;
}

.clickable-obj {
    position: absolute;
    cursor: pointer;
    transition: transform 0.2s, filter 0.2s;
    filter: drop-shadow(0 10px 8px rgba(0, 0, 0, 0.2));
    text-align: center;
}

.clickable-obj:hover {
    transform: scale(1.1) translateY(-5px);
    filter: drop-shadow(0 15px 12px rgba(0, 0, 0, 0.3));
}

.obj-emoji {
    font-size: 5rem;
}

.obj-label {
    font-size: 0.8rem;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    margin-top: -10px;
    position: relative;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.2s;
    font-weight: bold;
}

.clickable-obj:hover .obj-label {
    opacity: 1;
}

.violation-found {
    animation: highlightSuccess 1s forwards;
    pointer-events: none;
}

@keyframes highlightSuccess {
    50% {
        filter: drop-shadow(0 0 20px var(--success));
        transform: scale(1.2);
    }

    100% {
        opacity: 0.5;
        filter: grayscale(1);
    }
}

/* Level 2: Email Client */
.email-client {
    flex-grow: 1;
    display: flex;
    background: #f8fafc;
}

.email-sidebar {
    width: 250px;
    background: white;
    border-right: 1px solid #e2e8f0;
    padding: 20px 0;
}

.inbox-item {
    padding: 15px 20px;
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
}

.inbox-item.active {
    background: #e0e7ff;
    border-left: 4px solid var(--accent-main);
}

.inbox-sender {
    font-weight: bold;
    color: var(--text-dark);
    font-size: 0.9rem;
    margin-bottom: 5px;
}

.inbox-subj {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.email-view {
    flex-grow: 1;
    padding: 40px;
    display: flex;
    flex-direction: column;
}

.email-header {
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 20px;
    margin-bottom: 20px;
}

.email-subject {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 15px;
}

.email-meta {
    display: flex;
    gap: 15px;
    font-size: 0.9rem;
    color: var(--text-muted);
}

.suspicious-domain {
    color: var(--danger);
    font-weight: bold;
    background: #fee2e2;
    padding: 2px 6px;
    border-radius: 4px;
}

.email-body {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #334155;
    flex-grow: 1;
    white-space: pre-line;
}

.email-actions {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid #e2e8f0;
}

.btn-action {
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    border: none;
    font-size: 1rem;
    transition: transform 0.1s;
}

.btn-action:hover {
    transform: translateY(-2px);
}

.btn-reply {
    background: #e2e8f0;
    color: var(--text-dark);
}

.btn-process {
    background: var(--danger);
    color: white;
}

.btn-verify {
    background: var(--success);
    color: white;
}

/* Modals */
#feedback-modal {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.85);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 100;
    backdrop-filter: blur(5px);
    padding: 20px;
}

.feedback-card {
    background: white;
    border-radius: 20px;
    padding: 40px;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    text-align: left;
    position: relative;
}

.modal-title {
    font-size: 1.8rem;
    margin-bottom: 15px;
    font-weight: 900;
}

.compliance-tag {
    background: #f1f5f9;
    color: var(--accent-main);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 20px;
    display: inline-block;
    border: 1px solid #cbd5e1;
}

.modal-desc {
    font-size: 1.1rem;
    color: #334155;
    margin-bottom: 25px;
    line-height: 1.6;
}

</style></head><body><div id="game-container"><div id="screen-intro" class="screen active" style="justify-content: center; align-items: center; text-align: center; padding: 40px;"><div style="font-size: 5rem; margin-bottom: 10px;">🏢</div><h1 style="font-size: 3rem; color: var(--text-dark); font-weight: 900; margin-bottom: 10px;">Corporate Chronicles</h1><h2 style="color: var(--accent-main); margin-bottom: 30px; letter-spacing: 2px;">Data Defense Simulation</h2><p style="max-width: 600px; font-size: 1.2rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 40px;">Information security isn't just about firewalls and antivirus software. It' s about physical environment awareness and resisting psychological manipulation. <br><br><b>Can you survive the Friday night sweep and the Monday morning panic?</b></p><button class="btn-main" onclick="startLevel1()">Start Simulation</button></div><div id="screen-level1" class="screen"><div class="header-bar"><div class="level-title">Stage 1: The Clean Desk Dilemma</div><div class="score-badge" id="violation-tracker">Violations Found: 0 / 3</div></div><div class="office-env"><div class="office-wall">ACME CORP SECURITY SWEEP</div><div class="clickable-obj" style="left: 45%; top: 30%;" onclick="checkItem('pc')"><div class="obj-emoji">🖥️</div><div class="obj-label">Workstation</div></div><div class="clickable-obj" style="left: 48%; top: 25%; z-index: 5;" onclick="checkItem('sticky')"><div class="obj-emoji" style="font-size: 2rem;">🟨</div><div class="obj-label">Sticky Note</div></div><div class="clickable-obj" style="left: 70%; top: 40%;" onclick="checkItem('printer')"><div class="obj-emoji">🖨️</div><div class="obj-label">Printer</div></div><div class="clickable-obj" style="left: 20%; top: 45%;" onclick="checkItem('coffee')"><div class="obj-emoji">☕</div><div class="obj-label">Mug</div></div><div class="clickable-obj" style="left: 10%; top: 25%;" onclick="checkItem('plant')"><div class="obj-emoji">🪴</div><div class="obj-label">Plant</div></div><div class="clickable-obj" style="left: 35%; top: 55%;" onclick="checkItem('bag')"><div class="obj-emoji">💼</div><div class="obj-label">Briefcase</div></div></div></div><div id="screen-level2" class="screen"><div class="header-bar"><div class="level-title">Stage 2: The Urgent Transfer</div><div class="score-badge">Role: Accounts Payable Clerk</div></div><div class="email-client"><div class="email-sidebar"><div class="inbox-item active"><div class="inbox-sender">Richard CEO</div><div class="inbox-subj">URGENT: Titan Payment</div></div><div class="inbox-item"><div class="inbox-sender">HR Dept</div><div class="inbox-subj">Friday Pizza Party Reminder</div></div></div><div class="email-view"><div class="email-header"><div class="email-subject">URGENT: Wire Transfer for Titan Contract</div><div class="email-meta"><span><b>From:</b>Richard <span class="suspicious-domain">&lt;
richard.ceo@acme-corp.co&gt;
</span></span><span><b>To:</b>Accounts Payable</span><span style="color: var(--danger);"><b>Priority: High</b></span></div></div><div class="email-body" id="email-body-text">I am literally stepping onto a flight to London right now and cannot take calls. We are closing the Project Titan acquisition today. I need you to wire $50,
000 immediately to the new vendor escrow account below to secure the contract. If this is delayed,
we lose the deal. Account #8892-441-2 Routing: 1102933 Do not wait for my approval in the system,
just execute the wire and I will sign the paperwork when I land. - Richard Sent from my iPhone </div><div class="email-actions" id="email-buttons"><button class="btn-action btn-process" onclick="handleEmail('process')">💸 Process $50k Transfer</button><button class="btn-action btn-reply" onclick="handleEmail('reply')">↩️ Reply for Details</button><button class="btn-action btn-verify" onclick="handleEmail('call')">📱 Call CEO's Known Cell</button>
 </div></div></div></div><div id="screen-end" class="screen" style="justify-content: center; align-items: center; text-align: center; padding: 40px;"><h1 id="end-title" style="font-size: 3rem; margin-bottom: 20px; font-weight: 900;">Simulation Complete</h1><p id="end-desc" style="max-width: 600px; font-size: 1.2rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 40px;"></p><button class="btn-main" onclick="location.reload()">Replay Scenarios</button></div><div id="feedback-modal"><div class="feedback-card"><h2 class="modal-title" id="modal-title">Result</h2><div class="compliance-tag" id="modal-compliance">Compliance Info</div><p class="modal-desc" id="modal-desc">Details</p><div style="text-align: right;"><button class="btn-main" style="padding: 10px 25px; font-size: 1rem;" id="modal-btn" onclick="closeModal()">Understood</button></div></div></div></div><script> // Game State
let level=1;

let foundItems= {
    pc: false, sticky: false, printer: false
}

;
let violationsFound=0;
let modalCallback=null;

function switchScreen(screenId) {
    document.querySelectorAll('.screen').forEach(s=> s.classList.remove('active'));
    document.getElementById(screenId).classList.add('active');
}

function showModal(title, titleColor, compliance, desc, btnText, callback) {
    document.getElementById('modal-title').innerText=title;
    document.getElementById('modal-title').style.color=titleColor;

    document.querySelector('.feedback-card').style.borderTop=`8px solid $ {
        titleColor
    }

    `;

    document.getElementById('modal-compliance').innerHTML=`🛡️ $ {
        compliance
    }

    `;
    document.getElementById('modal-desc').innerText=desc;
    document.getElementById('modal-btn').innerText=btnText;
    modalCallback=callback;
    document.getElementById('feedback-modal').style.display='flex';
}

function closeModal() {
    document.getElementById('feedback-modal').style.display='none';
    if(modalCallback) modalCallback();
}

// --- LEVEL 1 LOGIC ---
function startLevel1() {
    switchScreen('screen-level1');
}

function checkItem(item) {
    if (item==='coffee') {
        showModal("Just a Mug!", "var(--text-muted)", "General Hygiene", "No security risk here. Just a cold cup of coffee. Don't spill it on the keyboard.", "Resume Sweep");
        return;
    }

    if (item==='plant' || item==='bag') {
        showModal("Nothing to see here.", "var(--text-muted)", "General Observation", "This item doesn't pose a data security threat.", "Resume Sweep");
        return;
    }

    if ( !foundItems[item]) {
        foundItems[item]=true;
        violationsFound++;

        document.getElementById('violation-tracker').innerText=`Violations Found: $ {
            violationsFound
        }

        / 3`;

        // Highlight element visually
        event.currentTarget.classList.add('violation-found');

        let title,
        compliance,
        desc;

        if (item==='pc') {
            title="Unlocked Workstation!";
            compliance="ISO 27001 A.11.2.8: Unattended User Equipment";
            desc="The coworker left for the weekend without hitting Win+L. Anyone could sit down and access corporate data, send emails as them, or install malware.";
        }

        else if (item==='sticky') {
            title="Password on Sticky Note!";
            compliance="ISO 27001 A.9.3.1: Use of Secret Authentication Info";
            desc="A classic mistake. The password 'Admin123!' is written on a post-it note attached to the monitor. Physical access easily defeats digital encryption.";
        }

        else if (item==='printer') {
            title="Abandoned Print Job!";
            compliance="CIS Control 3: Data Protection (Physical)";
            desc="A highly sensitive printed list of VIP clients was left sitting on the communal printer tray. Always use 'Secure Print' requiring a badge swipe to release documents.";
        }

        showModal(title, "var(--warning)", compliance, desc, violationsFound===3 ? "Proceed to Monday" : "Keep Searching", ()=> {
                if(violationsFound===3) startLevel2();
            });
    }
}

// --- LEVEL 2 LOGIC ---
function startLevel2() {
    switchScreen('screen-level2');
}

function handleEmail(action) {
    if (action==='reply') {
        // Update UI for branching narrative
        document.getElementById('email-body-text').innerHTML=`<b>Re: URGENT: Wire Transfer for Titan Contract</b><br><br><span style="color: var(--danger); font-weight: bold;" >I TOLD YOU I AM BOARDING !</span><br><br>Do not ask questions right now, the doors are closing. If you do not process this wire immediately, we will lose this multi-million dollar contract and we will have a serious conversation on Monday.<br><br>- Richard`;

        document.getElementById('email-buttons').innerHTML=` <button class="btn-action btn-process" onclick="handleEmail('process')">💸 Give in and Process Transfer</button><button class="btn-action btn-verify" onclick="handleEmail('call')">📱 Ignore Pressure & Call Cell</button>`;
    }

    else if (action==='process') {
        showModal("Catastrophic Fraud!", "var(--danger)", "CIS Control 14: Social Engineering", "You fell for Business Email Compromise (BEC). Notice the email address ended in '.co' instead of '.com'? The artificial urgency and authority manipulation caused the company to lose $50,000 to an offshore attacker.", "See Final Results", ()=> endGame(false));
    }

    else if (action==='call') {
        showModal("Fraud Prevented!", "var(--success)", "ISO 27001 A.8.2.3: Handling of Assets", "Excellent work! You recognized the artificial urgency and the spoofed domain. By verifying the request 'out-of-band' (calling a known good phone number), you discovered the real CEO was asleep at home. You saved the company $50,000.", "See Final Results", ()=> endGame(true));
    }
}

function endGame(victory) {
    switchScreen('screen-end');

    if(victory) {
        document.getElementById('end-title').innerText="Security Champion!";
        document.getElementById('end-title').style.color="var(--success)";
        document.getElementById('end-desc').innerText="You successfully secured the physical perimeter and defeated a highly targeted social engineering attack. You understand that true security requires a combination of clear policies, situational awareness, and a willingness to verify before trusting.";
    }

    else {
        document.getElementById('end-title').innerText="Security Breach!";
        document.getElementById('end-title').style.color="var(--danger)";
        document.getElementById('end-desc').innerText="While you managed to clean up the physical office environment, the psychological manipulation of the phishing attack bypassed your defenses. Remember: hackers don't always break in, they often just log in (or ask you to send the money).";
    }
}

</script></body></html>